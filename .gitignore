# ---- 依赖 / Dependencies ----
node_modules/

# ---- 构建产物 / Build output ----
dist/
server.js
server.js.map

# ---- 运行时数据 / Runtime data ----
# data/ 保存画布状态与服务端 LLM 配置（含 API Key），仅供本地使用，切勿提交。
data/
docs/

# ---- 环境变量 / Environment ----
.env
.env.local
.env.*.local


# ---- 本地个性化配置 ----
# Claude Code 本地设置（含个人偏好），随机器而异。
.claude/settings.local.json
# VS Code 个人设置（Python/conda 环境等），不入库。
.vscode/
# Google AI Studio 脚手架残留的空目录。
public/assets/

# ---- 日志 / Logs ----
*.log
npm-debug.log*

# ---- 操作系统文件 / OS files ----
.DS_Store
Thumbs.db

# ---- TypeScript 增量编译缓存 ----
*.tsbuildinfo
